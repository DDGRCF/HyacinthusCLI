{
  "data": {
    "command": "hyacinthus requirements parse",
    "description": "Agent 专用异步需求批量解析能力；CLI 自动轮询任务并返回最终候选记录，字段裁决仅由后端 errors 决定，warnings 永不阻断。",
    "domain": "requirements",
    "examples": [
      {
        "command": "hyacinthus requirements parse --file input.txt",
        "title": "从文本文件解析需求"
      },
      {
        "command": "hyacinthus requirements parse --file input.txt --strict",
        "title": "严格复核字段模板"
      }
    ],
    "id": "requirements.batch_parse",
    "introduced_in": "0.1.0",
    "method": "POST",
    "min_backend_version": "0.1.0",
    "path": "/api/v1/agent/requirements/batch-parse-jobs",
    "request_schema": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "default": "lenient",
          "description": "CSV/XLSX和标签文本按字段名及可识别别名映射到16字段规范，允许任意列数/顺序，缺失可选字段留空；未知/重复/冲突提供行级诊断，业务必填校验不变。默认 lenient，不调用 AI。",
          "enum": [
            "strict",
            "lenient"
          ],
          "type": "string"
        },
        "instance_id": {
          "description": "可选请求实例标识（i64 正整数）；授权身份由绑定 Agent token 确定，不用于选择授权用户。",
          "minimum": 1,
          "type": "integer"
        },
        "preset_city": {
          "description": "默认城市。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset_contact_phone": {
          "description": "默认联系电话。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset_contact_wechat": {
          "description": "默认微信号。",
          "type": [
            "string",
            "null"
          ]
        },
        "raw_text": {
          "description": "待批量解析的原始需求文本。",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "raw_text"
      ],
      "type": "object"
    },
    "required_scopes": [
      "requirements:parse"
    ],
    "response_schema": {
      "properties": {
        "rows": {
          "items": {
            "properties": {
              "can_auto_commit": {
                "description": "后端 errors 为空时为 true。",
                "type": "boolean"
              },
              "confirmation_reasons": {
                "description": "等于后端 errors，不包含 warnings。",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "errors": {
                "description": "后端字段错误，唯一字段阻断来源。",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "needs_confirmation": {
                "description": "后端 errors 非空时为 true。",
                "type": "boolean"
              },
              "parsed": {
                "description": "后端裁决的需求字段；geo_diagnostic 仅提供地理编码诊断，不阻断导入。",
                "properties": {
                  "geo_diagnostic": {
                    "description": "地理编码诊断，包含 quality、confidence、warnings、reverse 等字段。",
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "warnings": {
                "description": "非阻断解析警告；包括 GEO_* 地理编码诊断，不影响自动提交。",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "parsed",
              "errors",
              "can_auto_commit",
              "needs_confirmation",
              "confirmation_reasons"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "properties": {
            "auto_commit_ready": {
              "description": "可自动提交的行数。",
              "type": "integer"
            },
            "needs_confirmation": {
              "description": "存在后端 errors、需要修正的行数。",
              "type": "integer"
            }
          },
          "required": [
            "auto_commit_ready",
            "needs_confirmation"
          ],
          "type": "object"
        }
      },
      "required": [
        "rows",
        "summary"
      ],
      "type": "object"
    },
    "risk_level": "read",
    "supports_dry_run": "cli",
    "supports_file_upload": false,
    "supports_idempotency": false,
    "supports_pagination": false,
    "title": "批量解析需求"
  },
  "meta": {
    "command": "schema"
  },
  "ok": true
}
