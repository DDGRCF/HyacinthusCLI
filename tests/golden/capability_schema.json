{
  "data": {
    "command": "hyacinthus requirements parse",
    "description": "Agent 专用异步需求批量解析能力；CLI 自动轮询任务并返回最终候选记录。",
    "domain": "requirements",
    "examples": [
      {
        "command": "hyacinthus requirements parse --file input.txt",
        "title": "从文本文件解析需求"
      },
      {
        "command": "hyacinthus requirements parse --file input.txt --advanced-matching",
        "title": "启用先进匹配"
      }
    ],
    "id": "requirements.batch_parse",
    "introduced_in": "0.1.0",
    "method": "POST",
    "min_backend_version": "0.1.0",
    "path": "/api/v1/agent/requirements/batch-parse-jobs",
    "request_schema": {
      "additionalProperties": false,
      "properties": {
        "advanced_matching": {
          "default": false,
          "description": "是否启用先进匹配；默认使用固定字段严格解析。",
          "type": "boolean"
        },
        "instance_id": {
          "description": "Claw 实例 ID；静态 Agent key 调用时必填，session token 调用默认使用授权用户身份。",
          "minimum": 1,
          "type": "integer"
        },
        "preset_city": {
          "description": "默认城市。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset_contact_phone": {
          "description": "默认联系电话。",
          "type": [
            "string",
            "null"
          ]
        },
        "preset_contact_wechat": {
          "description": "默认微信号。",
          "type": [
            "string",
            "null"
          ]
        },
        "raw_text": {
          "description": "待批量解析的原始需求文本。",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "raw_text"
      ],
      "type": "object"
    },
    "required_scopes": [
      "requirements:parse"
    ],
    "response_schema": {
      "properties": {
        "rows": {
          "items": {
            "properties": {
              "can_auto_commit": {
                "type": "boolean"
              },
              "confidence": {
                "type": "number"
              },
              "confirmation_reasons": {
                "description": "需要确认的原因；地理编码低置信时包含 GEO_* 代码。",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "errors": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "needs_confirmation": {
                "type": "boolean"
              },
              "parsed": {
                "description": "解析后的需求字段；低置信地理编码会在 geo_diagnostic 中返回质量、置信度和 GEO_* 警告。",
                "properties": {
                  "geo_diagnostic": {
                    "description": "地理编码诊断，包含 quality、confidence、warnings、reverse 等字段。",
                    "type": [
                      "object",
                      "null"
                    ]
                  }
                },
                "type": "object"
              },
              "warnings": {
                "description": "解析警告；地理编码低置信时包含 GEO_* 代码。",
                "items": {
                  "type": "string"
                },
                "type": "array"
              }
            },
            "required": [
              "can_auto_commit",
              "needs_confirmation",
              "confirmation_reasons"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "summary": {
          "properties": {
            "auto_commit_ready": {
              "description": "可自动提交的行数。",
              "type": "integer"
            },
            "needs_confirmation": {
              "description": "需要人工确认的行数。",
              "type": "integer"
            }
          },
          "required": [
            "auto_commit_ready",
            "needs_confirmation"
          ],
          "type": "object"
        }
      },
      "required": [
        "rows",
        "summary"
      ],
      "type": "object"
    },
    "risk_level": "read",
    "supports_dry_run": "cli",
    "supports_file_upload": false,
    "supports_idempotency": false,
    "supports_pagination": false,
    "title": "批量解析需求"
  },
  "meta": {
    "command": "schema"
  },
  "ok": true
}
